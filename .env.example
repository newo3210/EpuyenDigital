# Copy to .env.local (repo root) and fill in. Never commit .env.local.
# Also usable as `.env` for worker / local-bot scripts.

# --- Container runtime -------------------------------------------------------
# Docker-compatible endpoint used by the Supabase CLI (npm run db:*).
# Windows + Podman default; scripts/supabase.mjs applies it automatically if unset.
# DOCKER_HOST=npipe:////./pipe/podman-machine-default

# --- App / feature flags -----------------------------------------------------
PET_REGISTRY_BOT_ENABLED=true
NODE_ENV=development
PORT=3000

# --- Supabase (panel auth — public) ------------------------------------------
# API URL. Local stack: http://127.0.0.1:54321 (printed by `npm run db:start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon (public) key. Local stack: ANON_KEY printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server / worker / webhook) ------------------------------------
# Same local URL; worker and webhook use these names.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY, bypasses RLS. Used by seed, webhook, worker, error logging.
SUPABASE_SERVICE_ROLE_KEY=

# --- Seed (npm run db:seed) --------------------------------------------------
# Initial admin operator created idempotently by supabase/seed/seed.ts.
# Password: at least 10 characters (matches auth minimum_password_length).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Webhook / Evolution (Inspectoría pet registry) --------------------------
# Shared secret Evolution must send (header x-webhook-secret or Bearer)
WEBHOOK_SECRET=dev-webhook-secret-change-me
INSPECTORIA_DISPLAY_PHONE=+5492944216586
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=inspectoria
EVOLUTION_API_KEY=replace-with-evolution-api-key
# Webhook target from Podman/Docker: http://host.containers.internal:3000/api/webhooks/evolution

# Send mode: dry_run | allowlist | production
SEND_MODE=allowlist
ALLOWLIST_PHONES=5492944216586

# Registration
REGISTRATION_SESSION_TTL_HOURS=24
PRIVACY_NOTICE_VERSION=v1
# Absolute path to location-help PNG (defaults to worker/assets/inspectoria/location-help.png)
LOCATION_HELP_IMAGE_PATH=

# LLM vision (OpenAI-compatible) — required for distinctive traits after registration
LLM_VISION_PROVIDER=openai
LLM_VISION_MODEL=gpt-4o-mini
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_API_KEY=
LLM_VISION_TIMEOUT_MS=30000

# Worker
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=5

# --- Cloud project (optional: db push / fallback / deploy) -------------------
# Project ref from the dashboard URL (https://<ref>.supabase.co).
SUPABASE_PROJECT_REF=
SUPABASE_CLOUD_URL=
SUPABASE_CLOUD_ANON_KEY=
# SERVER ONLY. Dashboard > Project Settings > API Keys.
SUPABASE_CLOUD_SERVICE_ROLE_KEY=
# Database password chosen when the project was created. Passed to the CLI only for
# `npm run db:push` / `supabase link` (never for the local stack, whose password differs).
SUPABASE_CLOUD_DB_PASSWORD=
