# Evolution API local stack - copy to `.env` (same folder) and set secrets.
# Never commit real API keys, passwords or phone numbers.

EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=

EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution
