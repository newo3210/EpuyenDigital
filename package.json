{
  "name": "epuyen-digital",
  "private": true,
  "type": "module",
  "description": "Mesa de Entrada Digital - Municipalidad de Epuyén",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @epuyen/web",
    "build": "npm run build -w @epuyen/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:db": "node scripts/supabase.mjs test db",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:push": "node scripts/supabase.mjs db push",
    "db:seed": "tsx --env-file=.env.local supabase/seed/seed.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "jsdom": "30.1.1",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
